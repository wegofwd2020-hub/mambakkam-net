---
/**
 * One residual trace on a plate, drawn server-side from real samples.
 *
 * The source design's chart took an SVG path and reverse-engineered tooltip
 * values out of its y-coordinates. That only works for a hand-drawn trace with
 * a declared axis meaning, and these pages state that the dotted bands are the
 * thresholds the daemon actually applied — so this takes the samples instead
 * and the tooltip reads the value it is pointing at.
 *
 * The polyline is computed here, at build time, so the chart paints with no
 * JavaScript. The hover readout is progressive enhancement, wired up once per
 * page by the script in the page that uses this.
 */
interface Props {
  /** `[secondsBeforeEnd, value]`, chronological, so t descends to zero. */
  samples: [number, number][];
  /** Optional consensus region, `[secondsBeforeEnd, low, high]`. */
  band?: [number, number, number][];
  /** Horizontal reference the step rule measures against. */
  target?: number | null;
  /** The applied step bounds, drawn dotted. */
  thresholds?: { upper: number; lower: number } | null;
  /** Seconds spanned by the plate, so every chart on a page shares an x-axis. */
  windowS: number;
  unit?: string;
  digits?: number;
  /** Tailwind height class for the plate. */
  height?: string;
  /** Caption, bottom-right, in the machine voice. */
  label?: string;
}

const {
  samples,
  band = [],
  target = null,
  thresholds = null,
  windowS,
  unit = '',
  digits = 2,
  height = 'h-40',
  label,
} = Astro.props;

// Authoring box. preserveAspectRatio="none" stretches it to the plate, per the
// source design's rule 6, so these numbers never need to match the rendered
// size.
const VW = 1000;
const VH = 200;
const PAD = 8;

/* The domain has to cover the thresholds as well as the samples, or a band the
   trace never approaches would be drawn outside the plate and silently clipped
   — which would read as "no threshold" rather than "threshold far away". */
const values = [
  ...samples.map(([, v]) => v),
  ...band.flatMap(([, lo, hi]) => [lo, hi]),
  ...(thresholds ? [thresholds.upper, thresholds.lower] : []),
  ...(target === null ? [] : [target]),
];
const lo = Math.min(...values);
const hi = Math.max(...values);
// A flat trace has zero range; give it one so it lands mid-plate rather than
// dividing by zero.
const span = hi - lo || Math.abs(hi) || 1;
const yMin = lo - span * 0.12;
const yMax = hi + span * 0.12;

const x = (t: number) => ((windowS - t) / (windowS || 1)) * VW;
const y = (v: number) => PAD + (1 - (v - yMin) / (yMax - yMin)) * (VH - PAD * 2);

/* Absence is the signal in the dropout scenario, so gaps must stay gaps. A
   single polyline would bridge them with a straight line, turning "no data" into
   "a value we measured". Split wherever the gap exceeds three sample intervals. */
const step = samples.length > 1 ? Math.abs(samples[0][0] - samples[1][0]) : 0;
const segments: string[] = [];
let current: string[] = [];
samples.forEach(([t, v], i) => {
  if (i > 0 && step > 0 && Math.abs(samples[i - 1][0] - t) > step * 3) {
    segments.push(current.join(' '));
    current = [];
  }
  current.push(`${x(t).toFixed(1)},${y(v).toFixed(1)}`);
});
if (current.length) segments.push(current.join(' '));

const bandPath = band.length
  ? [
      ...band.map(([t, , h]) => `${x(t).toFixed(1)},${y(h).toFixed(1)}`),
      ...[...band].reverse().map(([t, l]) => `${x(t).toFixed(1)},${y(l).toFixed(1)}`),
    ].join(' ')
  : '';

const GOLD = '#c9a84c';
const CREAM = '#f5f0e0';
const PANEL_HI = '#0f5c46';
const BG = '#03251c';

const hover = JSON.stringify({ samples, yMin, yMax, windowS, unit, digits, vw: VW, vh: VH });
---

<div
  class={`ags-chart relative w-full overflow-hidden border ${height}`}
  style={`background:${BG}80;border-color:${PANEL_HI}`}
  data-chart
>
  <svg viewBox={`0 0 ${VW} ${VH}`} preserveAspectRatio="none" class="h-full w-full">
    {bandPath && <polygon points={bandPath} fill={GOLD} opacity="0.08" />}
    {
      thresholds && (
        <>
          <line
            x1="0"
            x2={VW}
            y1={y(thresholds.upper)}
            y2={y(thresholds.upper)}
            stroke={GOLD}
            stroke-width="1"
            stroke-dasharray="6 6"
            opacity="0.55"
          />
          <line
            x1="0"
            x2={VW}
            y1={y(thresholds.lower)}
            y2={y(thresholds.lower)}
            stroke={GOLD}
            stroke-width="1"
            stroke-dasharray="6 6"
            opacity="0.55"
          />
        </>
      )
    }
    {
      target !== null && (
        <line x1="0" x2={VW} y1={y(target)} y2={y(target)} stroke={CREAM} stroke-width="1" opacity="0.25" />
      )
    }
    {segments.map((points) => <polyline points={points} fill="none" stroke={GOLD} stroke-width="1.5" />)}
    <g class="ags-cursor" style="display:none">
      <line y1="0" y2={VH} stroke={CREAM} stroke-width="0.4" opacity="0.4"></line>
      <circle r={VH / 40} fill={CREAM}></circle>
    </g>
  </svg>

  <span
    class="ags-tip pointer-events-none absolute left-2 top-1 hidden"
    style={`font-family:'JetBrains Mono Variable',ui-monospace,monospace;font-size:9px;color:${CREAM}`}></span>

  {
    label && (
      <span
        class="pointer-events-none absolute bottom-1 right-2"
        style={`font-family:'JetBrains Mono Variable',ui-monospace,monospace;font-size:8px;letter-spacing:0.1em;color:${GOLD}80`}
      >
        {label}
      </span>
    )
  }

  <!-- Data for the hover readout. is:inline because this is a data island, not
       a module: Astro would otherwise try to bundle it as script source. -->
  <script type="application/json" is:inline set:html={hover} />
</div>
