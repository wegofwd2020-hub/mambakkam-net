---
import Layout from '~/layouts/Layout.astro';
import '@fontsource/merriweather';

import lockup from '~/assets/images/kaundinya/kaundinya-lockup-ondark.svg?url';
import ogImage from '~/assets/images/kaundinya/kaundinya-labs-og.png';
import mentibleMark from '~/assets/images/work/mentible-mark.png';
import studybuddyMark from '~/assets/images/kaundinya/studybuddy-ondemand-mark.png';
import pramanaMark from '~/assets/images/work/pramana-logo.svg?url';
import kathaiMark from '~/assets/images/work/kathai-chithiram-logo.svg?url';
import thittamMark from '~/assets/images/work/thittam-logo.svg?url';

const metadata = {
  title: 'Kaundinya Labs — First to understand.',
  // Without this the site template appends ' — Mambakkam', so a shared link reads
  // as the personal site rather than the company.
  ignoreTitleTemplate: true,
  description:
    'An intellectual solutioning collective — we take on hard problems. Mentible, StudyBuddy OnDemand, Pramana, Kathai-Chithiram, Thittam and Atri Sangam.',
  openGraph: {
    // og:site_name defaults to the site name, so WhatsApp labels the preview card
    // 'Mambakkam'. astro-seo reads snake_case site_name; siteName is what this
    // repo's MetaDataOpenGraph type exposes. Both are set so the override lands
    // whichever one is honoured.
    site_name: 'Kaundinya Labs',
    siteName: 'Kaundinya Labs',
    // Landscape 1200x630 — the shape WhatsApp, iMessage and Slack crop previews to.
    // Imported rather than referenced from public/: adaptOpenGraphImages() runs the
    // value through Astro's image service, which treats a bare public path as a
    // remote image and then fails for want of intrinsic dimensions.
    images: [{ url: ogImage }],
  },
};

// `tryNow` means you can put your hands on it today; the chip says what it
// actually is. Those are different claims: StudyBuddy OnDemand has a reachable
// demo but no shipped product behind it (no apex DNS, and its own site work entry
// says in-progress), so it gets the emphasis without the word 'Live'.
/** One row of the portfolio list. Typed explicitly because an inferred union of
 *  object literals only exposes properties present on every member, so the
 *  logo-less row's `glyph` would not typecheck. */
type ProductRow = {
  name: string;
  native?: string;
  nativeClass?: string;
  /** Imported product logo. Omitted only when none exists yet. */
  mark?: string;
  /** Letterform fallback, used when `mark` is absent. */
  glyph?: string;
  href: string;
  label: string;
  status: string;
  /** Can a reader use it today? Not the same as "has shipped". */
  tryNow?: boolean;
  blurb: string;
};

const products: ProductRow[] = [
  {
    name: 'Mentible',
    mark: mentibleMark.src,
    href: 'https://mentible.app',
    label: 'mentible.app',
    status: 'Live',
    tryNow: true,
    blurb: 'Author a full book on any topic — lessons, tutorials, quizzes — then read it anywhere, offline.',
  },
  {
    name: 'StudyBuddy OnDemand',
    mark: studybuddyMark.src,
    href: 'https://demo.usestudybuddy.com',
    label: 'demo.usestudybuddy.com',
    status: 'Demo available',
    tryNow: true,
    blurb: 'AI lessons, quizzes and tutorials for Grades 5–12 in English, French and Spanish. Runs in a browser.',
  },
  {
    name: 'Pramana',
    native: 'प्रमाण',
    nativeClass: 'dv',
    mark: pramanaMark,
    href: 'https://mambakkam.net/work/pramana',
    label: 'mambakkam.net/work/pramana',
    status: 'In development',
    tryNow: false,
    blurb: 'Compliance training generated from the regulation, with a human approval gate and a tamper-evident record.',
  },
  {
    name: 'Kathai-Chithiram',
    native: 'கதை சித்திரம்',
    nativeClass: 'ta',
    mark: kathaiMark,
    href: 'https://mambakkam.net/kathai-chithiram',
    label: 'mambakkam.net/kathai-chithiram',
    status: 'Prototype',
    tryNow: false,
    blurb: 'Personalised visual social-story videos for children with autism.',
  },
  {
    name: 'Thittam',
    native: 'திட்டம்',
    nativeClass: 'ta',
    mark: thittamMark,
    href: 'https://mambakkam.net/thittam',
    label: 'mambakkam.net/thittam',
    status: 'In build',
    tryNow: false,
    blurb: "Production management that speaks your industry's language — film, construction, software, events.",
  },
  {
    name: 'Atri Sangam',
    native: 'अत्रि',
    nativeClass: 'dv',
    // No logo exists for this one yet, so it falls back to a letterform — see
    // .kl-mark.is-glyph in the styles.
    glyph: 'अ',
    href: 'https://mambakkam.net/atri-sangam',
    label: 'mambakkam.net/atri-sangam',
    // Alpha, and deliberately worded that way: its own site excerpt says the
    // monitor runs but its thresholds are not proven against real jamming
    // hardware. Never imply field validation.
    status: 'Alpha',
    tryNow: false,
    blurb:
      'A GPS integrity monitor for fixed sites — it cross-checks satellite time and position against independent references and says when they stop agreeing.',
  },
];
---

<Layout metadata={metadata}>
  <!-- Deliberately dark regardless of the site's colour-mode toggle: this is a
       branded page, and the diya only works against darkness. -->
  <section class="kl">
    <div class="kl-inner">
      <header class="kl-head">
        <img class="kl-lockup" src={lockup} alt="Kaundinya Labs — First to understand." width="790" height="133" />

        <div class="kl-orn" aria-hidden="true">
          <i></i><b></b><s></s><b></b><i class="r"></i>
        </div>

        <h1 class="kl-thesis">We choose problems <em>because</em> they are difficult.</h1>
        <p class="kl-sub">
          An intellectual solutioning collective. Six products so far — education, compliance, special-needs learning,
          production management, and GPS/timing integrity.
        </p>
      </header>

      <ul class="kl-rack">
        {
          products.map((p) => (
            <li>
              {/* The whole card is the link, so there is no small tap target on a phone. */}
              <a class={`kl-card${p.tryNow ? ' is-live' : ''}`} href={p.href}>
                {p.mark ? (
                  <img class="kl-mark" src={p.mark} alt="" width="56" height="56" loading="lazy" />
                ) : (
                  <span class="kl-mark is-glyph" aria-hidden="true">
                    {p.glyph}
                  </span>
                )}
                <div class="kl-body">
                  <div class="kl-head-row">
                    <h2 class="kl-name">{p.name}</h2>
                    {p.native && <span class={`kl-native ${p.nativeClass}`}>{p.native}</span>}
                    <span class={`kl-status${p.tryNow ? '' : ' soft'}`}>{p.status}</span>
                  </div>
                  <p class="kl-blurb">{p.blurb}</p>
                  <p class="kl-url">
                    {p.label}
                    <span class="kl-arrow" aria-hidden="true">
                      →
                    </span>
                  </p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>

      <footer class="kl-foot">
        <p>
          Mentible ships today; StudyBuddy OnDemand has a live demo. Start with those.
          <a href="mailto:wegofwd2020@gmail.com">wegofwd2020@gmail.com</a>
        </p>
      </footer>
    </div>
  </section>
</Layout>

<style>
  .kl {
    /* Palette lifted from the Kaundinya banner SVG's own path fills. */
    --gold: #dca84b;
    --gold-hi: #f6dc9a;
    --rust: #c86a3c;
    --text: #f4ecdd;
    --text-70: #c7d0c5;
    --text-45: #8e9b8c;

    position: relative;
    /* The site body is light (bg-page). Without this the cream page background
       shows below the content whenever the page is shorter than the viewport. */
    min-height: 100vh;
    padding: clamp(2rem, 6vw, 4.5rem) clamp(1rem, 4vw, 2rem) clamp(3rem, 7vw, 5rem);
    color: var(--text);
    font-family: 'Merriweather', Georgia, serif;
    /* Deep pine, darkened well past mambakkam.net's own #4A6B3C primary and pulled
       slightly blue-green so the gold reads warm against it. */
    background:
      radial-gradient(
        circle 320px at 50% 6rem,
        rgba(220, 168, 75, 0.26) 0,
        rgba(192, 57, 29, 0.09) 44%,
        transparent 72%
      ),
      radial-gradient(ellipse 90% 60% at 50% 118%, rgba(0, 0, 0, 0.55) 0, transparent 60%),
      linear-gradient(176deg, #102419 0%, #08150f 62%, #040c08 100%);
  }

  .kl-inner {
    max-width: 46rem;
    margin: 0 auto;
  }

  .kl-head {
    text-align: center;
  }

  .kl-lockup {
    display: block;
    width: min(100%, 30rem);
    height: auto;
    margin: 0 auto;
    filter: drop-shadow(0 0 20px rgba(220, 168, 75, 0.38)) drop-shadow(0 0 46px rgba(192, 57, 29, 0.22));
  }

  .kl-orn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: clamp(1.25rem, 4vw, 2rem) auto clamp(1rem, 3vw, 1.5rem);
    width: min(100%, 26rem);
  }
  .kl-orn i {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(220, 168, 75, 0.5));
  }
  .kl-orn i.r {
    background: linear-gradient(90deg, rgba(220, 168, 75, 0.5), transparent);
  }
  .kl-orn b {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--gold);
  }
  .kl-orn s {
    width: 10px;
    height: 10px;
    border: 1px solid var(--gold);
    border-radius: 50%;
    text-decoration: none;
  }

  .kl-thesis {
    font-size: clamp(1.65rem, 5.6vw, 2.5rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.012em;
    margin: 0 0 0.7rem;
    background: linear-gradient(172deg, var(--gold-hi) 8%, var(--gold) 48%, #b4822f 96%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .kl-thesis em {
    font-style: italic;
  }

  .kl-sub {
    font-size: clamp(0.95rem, 2.6vw, 1.075rem);
    line-height: 1.55;
    color: var(--text-70);
    margin: 0 auto;
    max-width: 34rem;
  }

  .kl-rack {
    list-style: none;
    margin: clamp(1.75rem, 5vw, 2.75rem) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .kl-card {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    column-gap: 1rem;
    align-items: start;
    padding: 1.05rem 1.15rem;
    border-radius: 0.6rem;
    border: 1px solid rgba(220, 168, 75, 0.17);
    background: linear-gradient(
      100deg,
      rgba(244, 236, 221, 0.055) 0%,
      rgba(244, 236, 221, 0.015) 60%,
      transparent 100%
    );
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.18s ease,
      transform 0.18s ease,
      background-color 0.18s ease;
  }
  .kl-card.is-live {
    border-color: rgba(220, 168, 75, 0.4);
    box-shadow: inset 3px 0 0 var(--gold);
    background: linear-gradient(100deg, rgba(220, 168, 75, 0.1) 0%, rgba(244, 236, 221, 0.02) 62%, transparent 100%);
  }
  .kl-card:hover,
  .kl-card:focus-visible {
    border-color: rgba(220, 168, 75, 0.65);
    transform: translateY(-1px);
  }
  .kl-card:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .kl-card {
      transition: none;
    }
    .kl-card:hover,
    .kl-card:focus-visible {
      transform: none;
    }
  }

  .kl-mark {
    width: 3.5rem;
    height: 3.5rem;
    object-fit: contain;
    /* Pramana and Thittam are navy tiles and StudyBuddy's is forest green — on a
       green ground they all need a lift behind them to stay separated. */
    background: rgba(244, 236, 221, 0.11);
    border-radius: 0.7rem;
    padding: 0.3rem;
  }

  /* Placeholder for a product with no logo yet (Atri Sangam). Deliberately a
     letterform in the page's own gold rather than an invented mark — it should be
     replaced the moment a real one exists. */
  .kl-mark.is-glyph {
    display: grid;
    place-items: center;
    font-family: 'Noto Serif Devanagari', serif;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--gold);
    padding: 0;
  }

  .kl-head-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 0.6rem;
  }

  .kl-name {
    font-size: clamp(1.15rem, 3.6vw, 1.45rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 0;
    color: var(--text);
  }
  .kl-native {
    font-size: 0.9rem;
    color: var(--text-45);
  }
  .kl-native.ta {
    font-family: 'Noto Sans Tamil', sans-serif;
  }
  .kl-native.dv {
    font-family: 'Noto Serif Devanagari', serif;
  }

  .kl-status {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #17110a;
    border-radius: 3px;
    padding: 0.2rem 0.45rem 0.15rem;
    background: linear-gradient(160deg, var(--gold-hi), var(--gold));
    white-space: nowrap;
  }
  .kl-status.soft {
    background: none;
    color: var(--text-45);
    border: 1px solid rgba(244, 236, 221, 0.22);
    font-weight: 400;
  }

  .kl-blurb {
    font-size: clamp(0.9rem, 2.5vw, 1rem);
    line-height: 1.45;
    color: var(--text-70);
    margin: 0.35rem 0 0.3rem;
  }

  .kl-url {
    overflow-wrap: anywhere;
    font-size: clamp(0.9rem, 2.5vw, 1rem);
    font-weight: 700;
    color: var(--gold);
    margin: 0;
  }
  .kl-arrow {
    margin-left: 0.4rem;
    transition: margin-left 0.18s ease;
  }
  .kl-card:hover .kl-arrow {
    margin-left: 0.7rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .kl-arrow,
    .kl-card:hover .kl-arrow {
      transition: none;
      margin-left: 0.4rem;
    }
  }

  .kl-foot {
    margin-top: clamp(1.5rem, 4vw, 2.25rem);
    padding-top: 1rem;
    border-top: 1px solid rgba(220, 168, 75, 0.2);
    text-align: center;
  }
  .kl-foot p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-45);
  }
  .kl-foot a {
    color: var(--gold);
    text-decoration: none;
    margin-left: 0.5rem;
  }
  .kl-foot a:hover {
    text-decoration: underline;
  }
</style>
