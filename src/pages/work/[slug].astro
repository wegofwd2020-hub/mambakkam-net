---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '~/layouts/PageLayout.astro';
import BareLayout from '~/layouts/Layout.astro';
import ThemeStyle from '~/components/ThemeStyle.astro';
import { themeById } from '~/themes';
// Loaded for every work page, not only themed ones: an @fontsource import is
// static. Two woff2 files against not duplicating this route, which is the
// trade the theme field exists to avoid.
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/work-sans';

export async function getStaticPaths() {
  const work = await getCollection('work', ({ data }) => !data.draft && !data.comingSoon);
  return work.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const workImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/work/*.{jpg,jpeg,png,webp}');
const workSvgs = import.meta.glob<string>('/src/assets/images/work/*.svg', {
  query: '?url',
  import: 'default',
});

const { item } = Astro.props;
const { Content } = await render(item);

const allPeople = await getCollection('people', ({ data }) => !data.draft);
const author = allPeople.find((p) => p.id === item.data.author);

const { title, excerpt, type, status, url, tags, image, theme, links, imageDisplay, ogImage } = item.data;

/* `links` supersedes `url`. The fallback keeps every entry that only sets a
   url rendering exactly as it did before. */
const ctas = links?.length ? links : url ? [{ label: 'Visit site', href: url }] : [];
const isExternal = (href: string) => /^https?:\/\//.test(href);

/* A themed entry renders through the bare layout: PageLayout supplies the
   site's cream header and footer, and those above a dark body read as a broken
   page rather than a deliberate one. Everything below is the same markup either
   way — only the wrapper and one class change, with the palette applied in the
   style block. */
const isEmerald = theme === 'emerald';
const Wrapper = isEmerald ? BareLayout : PageLayout;
// themeById throws on an unregistered id, so a typo in frontmatter fails the
// build rather than silently rendering in the wrong palette.
const activeTheme = theme ? themeById(theme) : null;

// Logo: raster (png/jpg/webp) is optimised via <Image>; svg is passed through as a URL.
const imageKey = image ? image.replace('~/', '/src/') : null;
const isSvg = imageKey?.endsWith('.svg') ?? false;
const resolvedImage = imageKey && !isSvg && workImages[imageKey] ? (await workImages[imageKey]()).default : null;
const svgLogoUrl = imageKey && isSvg && workSvgs[imageKey] ? await workSvgs[imageKey]() : null;

const typeLabel: Record<string, string> = {
  product: 'Product',
  project: 'Project',
  'open-source': 'Open Source',
  research: 'Research',
};

const statusColor: Record<string, string> = {
  live: 'text-green-700 bg-green-50 dark:text-green-300 dark:bg-green-900/30',
  'in-progress': 'text-amber-700 bg-amber-50 dark:text-amber-300 dark:bg-amber-900/30',
  'in-client-deployment': 'text-green-700 bg-green-50 dark:text-green-300 dark:bg-green-900/30',
  archived: 'text-gray-600 bg-gray-100 dark:text-gray-300 dark:bg-gray-800',
};

const statusLabel: Record<string, string> = {
  live: 'Live',
  'in-progress': 'In Progress',
  'in-client-deployment': 'In client deployment',
  archived: 'Archived',
};

/* og:image. Resolved through the same glob as the logos. Without an explicit
   card a work page inherits the site default, which is the village photo — so
   every project shared on LinkedIn previewed as Mambakkam rather than as
   itself. */
const ogKey = ogImage ? ogImage.replace('~/', '/src/') : null;
const resolvedOg = ogKey && workImages[ogKey] ? (await workImages[ogKey]()).default : null;

const metadata = {
  title,
  description: excerpt,
  ...(resolvedOg ? { openGraph: { images: [{ url: resolvedOg }] } } : {}),
};
---

<Wrapper metadata={metadata}>
  {activeTheme && <ThemeStyle theme={activeTheme} />}
  <div class:list={['work-detail', isEmerald && 'is-emerald']}>
    <div class="mx-auto max-w-3xl px-6 py-16">
      <!-- Header -->
      <header class="mb-12">
        {
          resolvedImage && (
            <Image
              src={resolvedImage}
              alt={`${title} logo`}
              width={224}
              height={224}
              class="w-28 h-28 object-contain mb-6"
            />
          )
        }
        {
          svgLogoUrl && (
            <img
              src={svgLogoUrl}
              alt={imageDisplay === 'illustration' ? `${title} illustration` : `${title} logo`}
              width={imageDisplay === 'illustration' ? 377 : 144}
              height={imageDisplay === 'illustration' ? 480 : 144}
              class={
                imageDisplay === 'illustration'
                  ? /* A detailed line illustration, not an icon: size it by height and
                       let the width follow, so it is legible rather than shrunk into
                       the square logo slot. */
                    'work-illustration h-72 sm:h-96 lg:h-[30rem] w-auto object-contain mb-8'
                  : 'w-36 h-36 object-contain mb-6'
              }
            />
          )
        }

        <div class="flex items-center gap-3 mb-4">
          <span class="text-sm font-heading font-medium text-muted uppercase tracking-widest">
            {typeLabel[type] ?? type}
          </span>
          <span class={`text-xs font-heading font-medium px-2.5 py-1 rounded-full ${statusColor[status] ?? ''}`}>
            {statusLabel[status] ?? status}
          </span>
        </div>

        <h1 class="text-4xl font-heading font-bold text-gray-900 dark:text-white mb-4">
          {title}
        </h1>

        <p class="text-xl leading-relaxed text-muted mb-6">{excerpt}</p>

        <div class="flex flex-wrap gap-3">
          {
            ctas.map((cta, i) => (
              <a
                href={cta.href}
                target={isExternal(cta.href) ? '_blank' : undefined}
                rel={isExternal(cta.href) ? 'noopener noreferrer' : undefined}
                class={`inline-flex items-center gap-2 text-sm btn ${i === 0 ? 'btn-primary' : 'btn-secondary'}`}
              >
                {isExternal(cta.href) && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <polyline points="15 3 21 3 21 9" />
                    <line x1="10" y1="14" x2="21" y2="3" />
                  </svg>
                )}
                {cta.label}
              </a>
            ))
          }
          {
            author && (
              <a href={`/people/${author.id}`} class="btn btn-secondary text-sm">
                By {author.data.name}
              </a>
            )
          }
        </div>
      </header>

      <!-- Tags -->
      {
        tags && tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-10">
            {tags.map((tag) => (
              <span class="text-xs font-mono px-2.5 py-1 rounded bg-gray-100 dark:bg-gray-800 text-muted">{tag}</span>
            ))}
          </div>
        )
      }

      <!-- Body content -->
      <section class="prose dark:prose-invert max-w-none mb-12">
        <Content />
      </section>

      <!-- Back -->
      <div class="back pt-8 border-t border-gray-200 dark:border-gray-700">
        <a href="/work" class="text-sm font-heading font-medium text-primary hover:underline"> ← All work </a>
        {
          isEmerald && (
            <a href="/atri-sangam" class="ml-4 text-sm font-heading font-medium">
              Overview →
            </a>
          )
        }
      </div>
    </div>
  </div>
</Wrapper>

<style>
  /* Illustrations ship as authored — black line work — which is correct on the
     cream page and invisible on the dark one (1.11:1 against rgb 18 16 12).
     Inverting under the site's .dark class turns the black lines white without
     touching the asset, so the file stays right wherever else it is reused.

     Keyed off .dark, not prefers-color-scheme: the theme is a class driven by
     the header toggle, and an OS-level media query would disagree with anyone
     whose toggle differs from their system setting. */
  .work-illustration {
    transition: filter 0.2s;
  }
  :global(.dark) .work-illustration {
    filter: invert(1);
  }

  /* "Emerald Prestige" — the palette the Atri Sangam demo pages use, applied to
     a work detail page that opts in via `theme: emerald`. Scoped entirely under
     .is-emerald, so the other eight catalog entries are untouched.

     The overrides are heavy-handed on purpose: the markup carries Tailwind
     colour utilities (text-gray-900, bg-gray-100) that would otherwise win, and
     duplicating the whole template to avoid them would be worse than out-
     specifying them here. */
  .is-emerald {
    /* Aliases onto the tokens ThemeStyle emits, so the rules below read the
       same as before while the values live in src/themes/. */
    --bg: var(--th-bg);
    --panel: var(--th-panel);
    --panel-hi: var(--th-panel-hi);
    --gold: var(--th-accent);
    --gold-soft: var(--th-accent-soft);
    --cream: var(--th-text);
    --mono: var(--th-mono);
    --sans: var(--th-sans);

    /* The site body is light. Without a full-height background the cream page
       shows below the content on short entries. */
    min-height: 100vh;
    background: var(--bg);
    color: var(--cream);
    font-family: var(--sans);
  }

  .is-emerald :global(h1) {
    font-family: var(--mono);
    font-weight: 500;
    line-height: 1.08;
    background-image: var(--th-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .is-emerald :global(h2),
  .is-emerald :global(h3),
  .is-emerald :global(h4) {
    font-family: var(--mono);
    color: var(--cream) !important;
    letter-spacing: -0.01em;
  }

  /* The type label ("Product") and the excerpt both ride on .text-muted. */
  .is-emerald :global(.text-muted) {
    color: #f5f0e0b3 !important;
  }

  /* Status pill — the utility classes carry amber/green backgrounds that fight
     the palette, so it is restated as a bordered chip like the demo pages use. */
  .is-emerald :global(header span[class*='rounded-full']) {
    background: var(--panel) !important;
    color: var(--gold-soft) !important;
    border: 1px solid var(--panel-hi);
    font-family: var(--mono);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .is-emerald :global(.btn) {
    background: var(--panel) !important;
    border: 1px solid var(--panel-hi) !important;
    color: var(--cream) !important;
    font-family: var(--mono);
    transition: border-color 160ms ease;
  }
  .is-emerald :global(.btn:hover) {
    border-color: #c9a84c66 !important;
  }

  /* Tag chips. */
  .is-emerald :global(.font-mono[class*='rounded']) {
    background: var(--panel) !important;
    border: 1px solid var(--panel-hi);
    color: #f5f0e0cc !important;
  }

  /* Tailwind Typography reads these custom properties. Both the base and the
     inverted set are written, because the page is dark whichever colour mode
     the visitor's browser reports. */
  /* The 8-digit values below carry opacity the tokens do not, so they stay
     literal. Everything else reads from the theme. */
  .is-emerald :global(.prose) {
    --tw-prose-body: #f5f0e0e6;
    --tw-prose-headings: var(--th-text);
    --tw-prose-lead: #f5f0e0b3;
    --tw-prose-links: var(--th-accent);
    --tw-prose-bold: var(--th-text);
    --tw-prose-counters: var(--th-accent);
    --tw-prose-bullets: var(--th-panel-hi);
    --tw-prose-hr: var(--th-panel-hi);
    --tw-prose-quotes: var(--th-text);
    --tw-prose-quote-borders: var(--th-accent);
    --tw-prose-captions: #f5f0e099;
    --tw-prose-code: var(--th-accent-soft);
    --tw-prose-pre-code: var(--th-text);
    --tw-prose-pre-bg: var(--th-bg);
    --tw-prose-th-borders: var(--th-panel-hi);
    --tw-prose-td-borders: #0f5c4680;
    --tw-prose-invert-body: #f5f0e0e6;
    --tw-prose-invert-headings: var(--th-text);
    --tw-prose-invert-lead: #f5f0e0b3;
    --tw-prose-invert-links: var(--th-accent);
    --tw-prose-invert-bold: var(--th-text);
    --tw-prose-invert-counters: var(--th-accent);
    --tw-prose-invert-bullets: var(--th-panel-hi);
    --tw-prose-invert-hr: var(--th-panel-hi);
    --tw-prose-invert-quotes: var(--th-text);
    --tw-prose-invert-quote-borders: var(--th-accent);
    --tw-prose-invert-captions: #f5f0e099;
    --tw-prose-invert-code: var(--th-accent-soft);
    --tw-prose-invert-pre-code: var(--th-text);
    --tw-prose-invert-pre-bg: var(--th-bg);
    --tw-prose-invert-th-borders: var(--th-panel-hi);
    --tw-prose-invert-td-borders: #0f5c4680;
  }

  /* The channels and flags tables are the densest thing on the page. */
  .is-emerald :global(.prose table) {
    font-size: 0.875rem;
  }
  .is-emerald :global(.prose th) {
    font-family: var(--mono);
    color: var(--gold) !important;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.7rem;
  }
  .is-emerald :global(.prose code) {
    font-family: var(--mono);
    background: var(--panel);
    border: 1px solid var(--panel-hi);
    border-radius: 2px;
    padding: 0.1em 0.35em;
  }
  /* Tailwind Typography wraps inline code in literal backticks via ::before
     and ::after. They read as punctuation in plain prose, but inside a
     bordered chip they look like a rendering fault. */
  .is-emerald :global(.prose code::before),
  .is-emerald :global(.prose code::after) {
    content: none;
  }
  .is-emerald :global(.prose pre) {
    border: 1px solid var(--panel-hi);
  }

  .is-emerald :global(.back) {
    border-color: var(--panel-hi) !important;
  }
  .is-emerald :global(.back a) {
    color: var(--gold) !important;
    font-family: var(--mono);
  }
</style>
