---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/Layout.astro';
import ThemeStyle from '~/components/ThemeStyle.astro';
import ThemeNav from '~/components/ThemeNav.astro';
import { themes } from '~/themes';
import ogImage from '~/assets/images/work-og.png';

// This page is Siva Mambakkam's work. When another person is added to /people,
// give them their own work page rather than listing everyone here.
const SITE_OWNER = 'siva-m';

const allWork = await getCollection(
  'work',
  ({ data }) => !data.draft && data.listed !== false && data.author === SITE_OWNER
);

const featured = allWork.filter((w) => w.data.featured);
const rest = allWork.filter((w) => !w.data.featured);
const ordered = [...featured, ...rest];

const typeLabel: Record<string, string> = {
  product: 'Product',
  project: 'Project',
  'open-source': 'Open Source',
  research: 'Research',
};

const statusLabel: Record<string, string> = {
  live: 'Live',
  'in-progress': 'In Progress',
  'in-client-deployment': 'In client deployment',
  archived: 'Archived',
};

/* Its own card, in the page's own Azure & Gold. Without this the page inherits
   the site card from config.yaml, so sharing /work and sharing / produced the
   same green banyan preview and nothing told the two links apart. */
const metadata = {
  title: 'Work from Mambakkam',
  description: 'Software products and projects from people of Mambakkam — built with care, shipped to the world.',
  openGraph: { type: 'website', images: [{ url: ogImage }] },
};

/* Azure & Gold. This page renders through the bare layout like the other
   themed pages, so it carries its own breadcrumb home — there is no site
   header above a dark ground. */
const t = themes.azure;
const { panel: PANEL, panelHi: PANEL_HI, accentSoft: GOLD_SOFT, text: TEXT } = t;
const MONO = t.mono;
---

<Layout metadata={metadata}>
  <ThemeStyle theme={t} />
  <div class="th-page w-full px-6 py-12 md:px-10 md:py-16">
    <div class="mx-auto flex w-full max-w-5xl flex-col gap-12">
      <!-- Site navigation. This page has no header of its own, so the strip
           carries it — see ThemeNav. -->
      <ThemeNav current="/work" />

      <!-- Header -->
      <header class="flex flex-col gap-5">
        <span class="th-eyebrow">Software &amp; Projects</span>
        <h1 class="th-h1 text-5xl tracking-tight md:text-6xl">Work</h1>
        <p class="max-w-3xl text-lg font-light leading-relaxed" style={`color:${TEXT}e6`}>
          Software products and projects from people of Mambakkam — built with care, shipped to the world.
        </p>
      </header>

      <section class="border-t pt-12" style={`border-color:${PANEL_HI}`}>
        {
          ordered.length === 0 ? (
            <p class="py-16 text-center" style={`color:${TEXT}99`}>
              Products coming soon.
            </p>
          ) : (
            <div class="grid gap-6 sm:grid-cols-2">
              {ordered.map((item) => {
                const comingSoon = item.data.comingSoon;
                const href = item.data.landingUrl ?? (comingSoon ? undefined : `/work/${item.id}`);
                const Tag = href ? 'a' : 'div';
                const tagProps = href
                  ? {
                      href,
                      class: 'th-card group block border p-6',
                      style: `background:${PANEL};border-color:${PANEL_HI}`,
                    }
                  : {
                      class: 'block border p-6 opacity-90',
                      style: `background:${PANEL};border-color:${PANEL_HI}`,
                    };
                return (
                  <Tag {...tagProps}>
                    <div class="flex items-center justify-between mb-3">
                      <span class="th-kicker" style={`color:${TEXT}99`}>
                        {typeLabel[item.data.type] ?? item.data.type}
                      </span>
                      <div class="flex items-center gap-2">
                        {comingSoon && (
                          <span
                            class="th-kicker inline-flex items-center rounded-full border px-2.5 py-0.5"
                            style={`color:${TEXT}99;border-color:${PANEL_HI}`}
                          >
                            Coming soon
                          </span>
                        )}
                        <span
                          class="th-kicker inline-flex items-center rounded-full border px-2.5 py-0.5"
                          style={`color:${GOLD_SOFT};background:${PANEL};border-color:${PANEL_HI}`}
                        >
                          {statusLabel[item.data.status] ?? item.data.status}
                        </span>
                      </div>
                    </div>

                    <h2 class="mb-2 mt-3 text-xl font-bold" style={`font-family:${MONO};color:${TEXT}`}>
                      {item.data.title}
                    </h2>

                    <p class="mb-4 line-clamp-3 text-sm font-light leading-relaxed" style={`color:${TEXT}b3`}>
                      {item.data.excerpt}
                    </p>

                    {item.data.tags && item.data.tags.length > 0 && (
                      <div class="flex flex-wrap gap-1.5">
                        {item.data.tags.map((tag) => (
                          <span
                            class="rounded border px-2 py-0.5 text-xs"
                            style={`font-family:${MONO};color:${TEXT}cc;background:${PANEL};border-color:${PANEL_HI}`}
                          >
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </Tag>
                );
              })}
            </div>
          )
        }
      </section>
    </div>
  </div>
</Layout>
